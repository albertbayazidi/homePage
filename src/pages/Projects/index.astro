---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('Projects');
---

<BaseLayout title="Projects" description="List of projects that I am proud of">
  <h1 class="text-5xl font-bold mb-10">Projects</h1>
  <div class="mb-16 sm:mb-24">
    {
      projects.length > 0 && (
        <div>
          {projects
            .sort((a: any, b: any) => b.data.coolFactor - a.data.coolFactor)
            .map((project: any) => (
              <div class="mb-8">
                <h2 class="flex items-center relative h-20">
                  <a
                    class="grow my-2 text-3xl font-bold"
                    href={`/Projects/${project.id}/`}
                  >
                    {project.data.title}
                  </a>
                  <span class="ml-2" set:html={project.data.svg} />
                </h2>
              </div>
            ))}
        </div>
      )
    }
  </div>
</BaseLayout>
