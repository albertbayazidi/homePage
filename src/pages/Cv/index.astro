---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CvEntry from "../../components/cvComps/cvItem.astro";
import SkillBadge from "../../components/cvComps/bagde.astro";
import { Cvdata } from "./data.js";
---

<BaseLayout
    title="CV"
    description="En oversikt over min erfaring og utdanning."
>
    <div class="max-w-4xl mx-auto p-4 sm:p-6">
        <header class="mb-12 text-center">
            <h1 class="text-4xl sm:text-5xl font-bold text-gray-50">CV</h1>
        </header>

        <section class="mb-12">
            <h2 class="text-2xl font-bold border-b-2 border-gray-700 pb-2 mb-6">
                Utdanning
            </h2>
            {
                Cvdata.utdanningItems.map((item) => (
                    <CvEntry
                        title={item.title}
                        subtitle={item.subtitle}
                        date={item.date}
                    />
                ))
            }
        </section>

        <section class="mb-12">
            <h2 class="text-2xl font-bold border-b-2 border-gray-700 pb-2 mb-6">
                Jobberfaring
            </h2>
            {
                Cvdata.jobberfaringItems.map((item) => (
                    <CvEntry
                        title={item.title}
                        subtitle={item.subtitle}
                        date={item.date}
                        tasks={item.oppgaveTekst}
                    />
                ))
            }
        </section>

        <section class="mb-12">
            <h2 class="text-2xl font-bold border-b-2 border-gray-700 pb-2 mb-6">
                Verv
            </h2>
            {
                Cvdata.vervItems.map((item) => (
                    <CvEntry
                        title={item.title}
                        subtitle={item.subtitle}
                        date={item.date}
                        tasks={item.oppgaveTekst}
                    />
                ))
            }
        </section>

        <section class="mb-12">
            <h2 class="text-2xl font-bold border-b-2 border-gray-700 pb-2 mb-6">
                Ferdigheter
            </h2>
            <div class="flex flex-wrap gap-2">
                {
                    Cvdata.ferdigheterItems.map((skill) => (
                        <SkillBadge text={skill} />
                    ))
                }
            </div>
        </section>

        <div
            class="grid grid-cols-1 md:grid-cols-2 gap-8 text-center md:text-left"
        >
            <section>
                <h2 class="text-xl font-bold mb-2">Språk</h2>
                <p class="text-gray-300">
                    Flytende i norsk og engelsk, både skriftlig og muntlig.
                </p>
            </section>
            <section>
                <h2 class="text-xl font-bold mb-2">Referanser</h2>
                <p class="text-gray-300">Oppgis ved forespørsel.</p>
            </section>
        </div>
    </div>
</BaseLayout>
