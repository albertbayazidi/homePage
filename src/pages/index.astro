---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../site-config';
import LanguagesAndTeks from '../components/language.md';
---

<BaseLayout description={siteConfig.description}>
  <img
    src="https://avatars.githubusercontent.com/u/102351774?v=4"
    class="rounded-full sm:size-80 size-60 mb-10"
    alt="pb"
  />
  <h1 class="text-4xl font-bold mb-5">Albert Bayazidi</h1>
  <p class="my-4 text-lg text-gray-300">
    Velkomen til min nettside. Jeg heter Albert og er ferdig utdanna
    sivilingeniør fra NTNU. Studiet mitt var fysikk og matematikk, hvor
    spesialiseringen min var i nummerik. Jeg har erfaring med FEM pakker som
    FEniCS, gridap, firedrake, og netgen/NGSolve. Ellers er jeg veldig glad i å
    cadde, matlaging og lesing.
  </p>

  <p class="mb-5">Dette er noen av teknologiene jeg bruker</p>

  <LanguagesAndTeks />
</BaseLayout>
