---
interface Props {
    items: (string | { tittel: string; oppgaveTekst: string[] })[];
}

const { items = [] } = Astro.props;
---

<ul class="list-disc list-inside">
    {
        items.map((item, index) => (
            <li class:list={[{ "pb-4": index === 0 }]}>
                {typeof item === "string" ? (
                    item
                ) : (
                    <>
                        {item.tittel}
                        <ul class="list-disc list-inside pl-5">
                            {item.oppgaveTekst.map((task) => (
                                <li class="pb-1">{task}</li>
                            ))}
                        </ul>
                    </>
                )}
            </li>
        ))
    }
</ul>
