---
interface Props {
  title: string;
  subtitle: string;
  date: string;
  tasks?: string[];
}

const { title, subtitle, date, tasks } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-4 gap-2 md:gap-6 mb-8">
  <div class="md:text-right text-sm text-gray-400 font-medium">
    {date}
  </div>

  <div class="md:col-span-3">
    <h3 class="text-lg font-bold text-gray-100">{title}</h3>
    <p class="mt-1 text-md font-semibold text-gray-300">{subtitle}</p>
    {
      tasks && (
        <ul class="list-disc list-inside mt-3 text-gray-300 space-y-1">
          {tasks.map(task => (
            <li>{task}</li>
          ))}
        </ul>
      )
    }
  </div>
</div>
